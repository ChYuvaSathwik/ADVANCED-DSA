class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
class SingleLinkedList:
    def __init__(self):
        self.head=None
    def insert_end(self,data):
        N1=Node(data)
        if self.head is None:
            self.head=N1
        else:
            temp=self.head
            while temp.next:
                temp=temp.next
            temp.next=N1
    def delete_at_begin(self):
        if self.head is None:
            print("EMPTY LINKED LIST")
            return
        else:
            temp=self.head
            self.head=temp.next
            temp=None
    def delete_end(self):
        if self.head is None:
            print("Empty Linked List")
            return
        elif self.head.next is None:
            self.head=None
            return
        else:
            temp=self.head.next
            prev=self.head
            while temp.next:
                if temp is None:
                    print("Out of range")
                    return
                else:
                    temp=temp.next
                    prev=prev.next
            prev.next=None


    def display(self):
        if self.head is None:
            print("Empty Linked List")
        else:
            temp=self.head
            while temp:
                print(temp.data,end="->")
                temp=temp.next
            print("None")
L=SingleLinkedList()
N=int(input("enter the number of nodes to insert"))
for i in range(N):
    value=int(input())
    L.insert_end(value)
L.delete_at_begin()
L.delete_end()
L.display()
