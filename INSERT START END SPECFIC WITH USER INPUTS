class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
class SingleLinkedList:
    def __init__(self):
        self.head=None
    def insert_end(self,data):
        N1=Node(data)
        if self.head is None:
            self.head=N1
        else:
            temp=self.head
            while temp.next:
                temp=temp.next
            temp.next=N1
    def insert_begin(self,data):
        N2=Node(data)
        if self.head is None:
            self.head=N2
        else:
            temp=self.head
            N2.next=temp
            self.head=N2
    def insert_at_desired_postion(self,data,pos):
        N3=Node(data)
        if self.head is None:
            print("Empty linked list")
            return
        elif pos==1:
            temp=self.head
            N3.next=temp
            self.head=N3
            return
        else:
            temp=self.head.next
            prev=self.head
            for i in range(pos-2):
                if temp is None:
                    print("Out of range")
                    return
                else:
                    temp=temp.next
                    prev=prev.next
            prev.next=N3
            N3.next=temp
    def display(self):
        if self.head is None:
            print("Empty linked list")
        else:
            temp=self.head
            while temp:
                print(temp.data,end="->")
                temp=temp.next
            print("None")
